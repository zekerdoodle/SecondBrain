        if has_identity_refs and "elements" in extra_params:
            return _error(
                "Error: identity_image_paths cannot be combined with "
                "extra_params.elements. Use identity_image_paths for local identity "
                "refs or extra_params.elements for explicit public URL elements."
            )
        if has_identity_refs and param_name != "start_image_url":
            return _error(
                "Error: identity_image_paths requires Kling v3 image-to-video's "
                "start_image_url mapping; remove image_param_name override."
            )

        ignored_reference_count = 0
        paths_to_process = requested_paths
        if ref_mode == "single" and len(requested_paths) > 1:
            ignored_reference_count = len(requested_paths) - 1
            paths_to_process = requested_paths[:1]
            logger.warning(
                f"Model {model} only accepts a single reference image. "
                f"Using first of {len(requested_paths)} provided."
            )

        cdn_urls = []
        source_paths = []
        for i, path in enumerate(paths_to_process):
            source_paths.append(path)
            if path.startswith(("http://", "https://")):
                cdn_urls.append(path)
                continue
            resolved = _resolve_path(path)
            if not os.path.isfile(resolved):
                return _error(f"Reference image not found: {resolved}")
            logger.info(
                f"Uploading video reference image {i+1}/{len(paths_to_process)}: {path}"
            )
            url = await _upload_to_fal_cdn(path)
            cdn_urls.append(url)

        if not cdn_urls:
            return _error("Error: no valid reference images after upload")

        identity_urls = []
        identity_source_paths = []
        for i, path in enumerate(requested_identity_paths):
            identity_source_paths.append(path)
            if path.startswith(("http://", "https://")):
                identity_urls.append(path)
                continue
            resolved = _resolve_path(path)
            if not os.path.isfile(resolved):
                return _error(f"Identity image not found: {resolved}")
            logger.info(
                f"Uploading identity image {i+1}/{len(requested_identity_paths)}: {path}"
            )
            url = await _upload_to_fal_cdn(path)
            identity_urls.append(url)

        payload: Dict[str, Any] = {
            "prompt": prompt,
        }
        if ref_mode == "single":
            payload[param_name] = cdn_urls[0]
        else:
            payload[param_name] = cdn_urls
        if duration is not None:
            payload["duration"] = duration
        if resolution:
            payload["resolution"] = resolution
        if aspect_ratio:
            payload["aspect_ratio"] = aspect_ratio
        effective_extra_params = dict(extra_params)
        payload.update(effective_extra_params)
        constructed_elements = None
        if identity_urls:
            constructed_elements = [
                {
                    "frontal_image_url": identity_urls[0],
                    "reference_image_urls": identity_urls[1:],
                }
            ]
            payload["elements"] = constructed_elements

        logger.info(
            f"fal video: model={model}, param={param_name}, mode={ref_mode}, "
            f"{len(cdn_urls)} ref(s), {len(identity_urls)} identity ref(s), "
            f"queue=internal, prompt={prompt[:80]}..."
        )
        result = await _fal_run(
            model,
            payload,
            use_queue=True,
            max_wait_seconds=max_wait_seconds,
        )

        video_url, video_metadata = _extract_video_result(result)
        local_path = _resolve_video_output_path(output_path, video_url)
        await _download_file(video_url, local_path)
        file_size = _file_size_or_error(local_path)
        metadata = _collect_video_metadata(result, video_metadata)

        text = (
            f"Generated video via {model} with {len(cdn_urls)} "
            "reference/start image(s):\n"
        )
        text += f"  Prompt: {prompt}\n"
        text += f"  Model: {model}\n"
        if ref_mode == "single":
            text += f"  Scene/start image: {source_paths[0]}\n"
        else:
            text += f"  References used ({len(source_paths)}):\n"
            for path in source_paths:
                text += f"    - {path}\n"
        if ignored_reference_count:
            text += (
                f"  Ignored references: {ignored_reference_count} "
                "extra image(s); model uses a single start image\n"
            )
        if identity_source_paths:
            text += f"  Identity refs used ({len(identity_source_paths)}):\n"
            for path in identity_source_paths:
                text += f"    - {path}\n"
            text += f"  Constructed elements: {constructed_elements}\n"
        text += f"  Param: {param_name}, Mode: {ref_mode}\n"
        text += (
            "  Direct call: waits for completion "
            f"(wait budget: {float(max_wait_seconds):g}s; "
            "internal queue-backed polling)\n"
        )
        if duration is not None:
            text += f"  Requested duration: {duration}\n"
        if resolution:
            text += f"  Requested resolution: {resolution}\n"
        if aspect_ratio:
            text += f"  Requested aspect ratio: {aspect_ratio}\n"
        if effective_extra_params:
            text += f"  Extra: {effective_extra_params}\n"
        if metadata:
            meta_text = ", ".join(f"{key}={value}" for key, value in metadata.items())
            text += f"  Returned metadata: {meta_text}\n"
        text += f"  Remote video: {video_url}\n"
        text += f"  Local output: {local_path}\n"
        text += f"  File size: {file_size} bytes\n"
        return _success(text)

    except Exception as e:
        msg = _fmt_exc(e)
        logger.error(f"fal reference-to-video failed: {msg}")
        return _error(f"fal reference-to-video failed: {msg}")


@register_tool("image")
@tool(
    name="fal_list_models",
    description="""Search and list available models on fal.ai.

Can search by text query, filter by category/status, or look up specific endpoint IDs.
Returns model IDs, names, descriptions, and categories. Use this to discover correct
endpoint IDs for the other fal tools.

Common categories: text-to-image, image-to-image, image-to-video, text-to-video, training.
The endpoint_id returned here is exactly what you pass as 'model' to the other tools.""",
    input_schema={
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "description": "Free-text search query (e.g. 'seedream', 'flux', 'grok imagine').",
            },
            "endpoint_id": {
                "type": "string",
                "description": "Look up a specific model by endpoint ID (e.g. 'fal-ai/flux/dev'). Returns full details for that model.",
            },
            "category": {
                "type": "string",
                "description": "Filter by category: 'text-to-image', 'image-to-image', 'image-to-video', 'text-to-video', 'training', etc.",
            },
            "status": {
                "type": "string",
                "description": "Filter by status: 'active' or 'deprecated'. Default: all.",
                "enum": ["active", "deprecated"],
            },
            "limit": {
                "type": "integer",
                "description": "Max number of results to return.",
                "default": 20,
                "minimum": 1,
                "maximum": 100,
            },
        },
    },
)
async def fal_list_models(args: Dict[str, Any]) -> Dict[str, Any]:
    """Search available models on fal.ai."""
    query = args.get("query", "")
    endpoint_id = args.get("endpoint_id", "")
    category = args.get("category", "")
    status = args.get("status", "")
    limit = min(max(args.get("limit", 20), 1), 100)

    params: Dict[str, Any] = {"limit": limit}
    if query:
        params["q"] = query
    if endpoint_id:
        params["endpoint_id"] = endpoint_id
    if category:
        params["category"] = category
    if status:
        params["status"] = status

    try:
        async with httpx.AsyncClient(timeout=HTTP_TIMEOUT) as client:
            resp = await client.get(
                f"{FAL_API_BASE}/v1/models",
                headers={"Authorization": f"Key {_get_fal_key()}"},
                params=params,
            )
            resp.raise_for_status()
            data = resp.json()

        models = data.get("models", [])
        if not models:
            return _success("No models found matching your query.")

        lines = [f"Found {len(models)} model(s):\n"]
        for m in models:
            eid = m.get("endpoint_id", "unknown")
            meta = m.get("metadata", {})
            name = meta.get("display_name", eid)
            cat = meta.get("category", "")
            desc = meta.get("description", "")
            m_status = meta.get("status", "")
            tags = meta.get("tags", [])
            price_est = meta.get("duration_estimate")

            line = f"  [{eid}] {name}"
            if cat:
                line += f" ({cat})"
            if m_status and m_status != "active":
                line += f" [{m_status}]"
            if tags:
                line += f" {' '.join(f'#{t}' for t in tags[:3])}"
            lines.append(line)
            if desc:
                lines.append(f"    {desc[:150]}")
            if price_est:
                lines.append(f"    ~{price_est:.1f}s per run")

        has_more = data.get("has_more", False)
        if has_more:
            lines.append(f"\n  (more results available — increase limit or refine query)")

        return _success("\n".join(lines))

    except Exception as e:
        logger.error(f"fal list models failed: {e}")
        return _error(f"fal list models failed: {e}")


